;no force imposed on lipid bilayer
;compression simulations for DPPC membrane + DPPS 
integrator               = md
tinit                    = 0.0
dt                       = 0.020
nsteps                   = 50000000 ;1000ns
nstlog                   = 100000 ;tells how often log file is written (previously 1000)
nstenergy                = 100000 ;tells how often energy data is written
nstxout-compressed       = 100000 ;tells how often coordinates are saved to the trj file
compressed-x-precision   = 100

cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz
verlet-buffer-tolerance  = 0.005

epsilon_r                = 15
coulombtype              = reaction-field
rcoulomb                 = 1.1
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1

tcoupl                   = v-rescale
tc-grps                  = system
tau_t                    = 1.0
ref_t                    = 285

; Pressure coupling:
Pcoupl                   = berendsen
Pcoupltype               = anisotropic
tau_p                    = 12
compressibility          = 3e-4 0 3e-4  0 0 0 ; xx yy zz xy xz yz ;volume can change in xx and zz dimension
ref_p                    = 50 1.0 1.0 0 0 0 ;change in pressure in the x-dimension

; GENERATE VELOCITIES FOR STARTUP RUN:
gen_vel                  = no

refcoord_scaling         = all
